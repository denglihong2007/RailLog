@page "/"
@using System.Security.Claims
@using RailLog.Data
@using RailLog.Services
@using RailLog.Shared.Components
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject TripService TripService

<PageTitle>首页 - 轨记</PageTitle>

<div class="home-dashboard container py-2">
    @if (isLoading)
    {
        <div class="dashboard-loading text-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="text-muted mt-3 mb-0">正在整理你的行程成就...</p>
        </div>
    }
    else if (!isAuthenticated)
    {
        <section class="dashboard-empty card border-0 shadow-sm">
            <div class="card-body py-4">
                <h2 class="h4 mb-2">登录后查看你的铁路成就</h2>
                <p class="text-muted mb-3">成就墙会展示你的线路、里程、车型和票价统计。</p>
                <a href="Account/Login" class="btn btn-primary">去登录</a>
            </div>
        </section>
    }
    else
    {
        if (stats.TotalTrips == 0)
        {
            <section class="dashboard-empty card border-0 shadow-sm">
                <div class="card-body py-4">
                    <h2 class="h4 mb-2">还没有可展示的成就</h2>
                    <p class="text-muted mb-3">先记录第一条行程，成就墙会自动点亮。</p>
                    <a href="/add-trip" class="btn btn-success">记录第一条行程</a>
                </div>
            </section>
        }
        else
        {
            <section class="dashboard-hero">
                <div>
                    <p class="dashboard-hero__eyebrow mb-1">铁路生涯总览</p>
                    <h2 class="dashboard-hero__title mb-2">你已累计出发 @stats.TotalTrips 次</h2>
                    <p class="dashboard-hero__meta mb-0">
                        记录时间：@stats.FirstTripDate?.ToString("yyyy-MM-dd") 至 @stats.LatestTripDate?.ToString("yyyy-MM-dd")
                    </p>
                </div>
                <div class="dashboard-rank">
                    <div class="dashboard-rank__label">当前称号</div>
                    <div class="dashboard-rank__name">@stats.ExplorerLevel</div>
                    <div class="dashboard-rank__mileage">@stats.TotalMileageKm.ToString("N1") km</div>
                </div>
            </section>

            <section class="stats-grid">
                <article class="stat-card">
                    <p class="stat-card__label">去过线路</p>
                    <p class="stat-card__value">@stats.UniqueRoutes</p>
                    <p class="stat-card__hint">@stats.RouteStatHint</p>
                </article>
                <article class="stat-card">
                    <p class="stat-card__label">乘车次数</p>
                    <p class="stat-card__value">@stats.TotalTrips</p>
                    <p class="stat-card__hint">覆盖 @stats.UniqueTrainNumbers 个车次</p>
                </article>
                <article class="stat-card">
                    <p class="stat-card__label">累计花费</p>
                    <p class="stat-card__value">¥@stats.TotalSpend.ToString("N2")</p>
                    <p class="stat-card__hint">单次最高 ¥@stats.HighestFare.ToString("N2")</p>
                </article>
                <article class="stat-card">
                    <p class="stat-card__label">累计里程</p>
                    <p class="stat-card__value">@stats.TotalMileageKm.ToString("N1") km</p>
                    <p class="stat-card__hint">单次最长 @stats.LongestTripMileageKm.ToString("N1") km</p>
                </article>
                <article class="stat-card">
                    <p class="stat-card__label">车型种类</p>
                    <p class="stat-card__value">@stats.UniqueRollingStockTypes</p>
                    <p class="stat-card__hint">有记录车型 @stats.RollingStockRecords 次</p>
                </article>
                <article class="stat-card">
                    <p class="stat-card__label">到访车站</p>
                    <p class="stat-card__value">@stats.UniqueStations</p>
                    <p class="stat-card__hint">席别覆盖 @stats.UniqueSeatTypes 种</p>
                </article>
            </section>

            <section class="achievement-wall mt-4">
                <div class="achievement-wall__header">
                    <h3 class="mb-0">成就墙</h3>
                    <span class="text-muted small">按当前记录自动解锁</span>
                </div>
                <div class="achievement-grid mt-3">
                    @foreach (var achievement in achievements)
                    {
                        <article class="achievement-card @(achievement.Unlocked ? "is-unlocked" : "is-locked")">
                            <div class="achievement-card__icon">
                                <i class="@achievement.IconClass"></i>
                            </div>
                            <div>
                                <p class="achievement-card__name mb-1">@achievement.Name</p>
                                <p class="achievement-card__tier mb-1">等级：@achievement.TierName</p>
                                <p class="achievement-card__value mb-1">@achievement.CurrentText</p>
                                <p class="achievement-card__next mb-0">@achievement.NextTargetText</p>
                            </div>
                        </article>
                    }
                </div>
            </section>
        }

        @if (HasLeaderboardData)
        {
            <section class="leaderboard mt-4">
                <div class="achievement-wall__header">
                    <h3 class="mb-0">全服排行榜</h3>
                    <span class="text-muted small">按所有用户行程记录统计</span>
                </div>

                <div class="leaderboard-grid mt-3">
                    <article class="leaderboard-card">
                        <h4 class="leaderboard-card__title">花费榜</h4>
                        <ol class="leaderboard-list">
                            @for (var i = 0; i < leaderboard.TopBySpend.Count; i++)
                            {
                                var entry = leaderboard.TopBySpend[i];
                                <li class="leaderboard-item">
                                    <span class="leaderboard-item__rank">@($"{i + 1:00}")</span>
                                    <span class="leaderboard-item__avatar">
                                        @if (!string.IsNullOrWhiteSpace(entry.AvatarUrl))
                                        {
                                            <img src="@entry.AvatarUrl" alt="@($"{entry.DisplayName}头像")" />
                                        }
                                        else
                                        {
                                            <span>@GetAvatarInitial(entry.DisplayName)</span>
                                        }
                                    </span>
                                    <span class="leaderboard-item__name">@entry.DisplayName</span>
                                    <span class="leaderboard-item__value">¥@entry.TotalSpend.ToString("N2")</span>
                                </li>
                            }
                        </ol>
                    </article>

                    <article class="leaderboard-card">
                        <h4 class="leaderboard-card__title">行程榜</h4>
                        <ol class="leaderboard-list">
                            @for (var i = 0; i < leaderboard.TopByTrips.Count; i++)
                            {
                                var entry = leaderboard.TopByTrips[i];
                                <li class="leaderboard-item">
                                    <span class="leaderboard-item__rank">@($"{i + 1:00}")</span>
                                    <span class="leaderboard-item__avatar">
                                        @if (!string.IsNullOrWhiteSpace(entry.AvatarUrl))
                                        {
                                            <img src="@entry.AvatarUrl" alt="@($"{entry.DisplayName}头像")" />
                                        }
                                        else
                                        {
                                            <span>@GetAvatarInitial(entry.DisplayName)</span>
                                        }
                                    </span>
                                    <span class="leaderboard-item__name">@entry.DisplayName</span>
                                    <span class="leaderboard-item__value">@entry.TotalTrips 次</span>
                                </li>
                            }
                        </ol>
                    </article>

                    <article class="leaderboard-card">
                        <h4 class="leaderboard-card__title">里程榜</h4>
                        <ol class="leaderboard-list">
                            @for (var i = 0; i < leaderboard.TopByMileage.Count; i++)
                            {
                                var entry = leaderboard.TopByMileage[i];
                                <li class="leaderboard-item">
                                    <span class="leaderboard-item__rank">@($"{i + 1:00}")</span>
                                    <span class="leaderboard-item__avatar">
                                        @if (!string.IsNullOrWhiteSpace(entry.AvatarUrl))
                                        {
                                            <img src="@entry.AvatarUrl" alt="@($"{entry.DisplayName}头像")" />
                                        }
                                        else
                                        {
                                            <span>@GetAvatarInitial(entry.DisplayName)</span>
                                        }
                                    </span>
                                    <span class="leaderboard-item__name">@entry.DisplayName</span>
                                    <span class="leaderboard-item__value">@entry.TotalMileageKm.ToString("N1") km</span>
                                </li>
                            }
                        </ol>
                    </article>
                </div>
            </section>
        }
    }
</div>

@code {
    private bool isLoading = true;
    private bool isAuthenticated;
    private DashboardStats stats = DashboardStats.Empty;
    private List<AchievementItem> achievements = [];
    private TripService.GlobalLeaderboard leaderboard = TripService.GlobalLeaderboard.Empty;
    private bool HasLeaderboardData => leaderboard.TopBySpend.Count > 0 || leaderboard.TopByTrips.Count > 0 || leaderboard.TopByMileage.Count > 0;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        isAuthenticated = user.Identity?.IsAuthenticated == true;

        if (!isAuthenticated)
        {
            isLoading = false;
            return;
        }

        leaderboard = await TripService.GetGlobalLeaderboardAsync();

        var userId = user.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        if (string.IsNullOrWhiteSpace(userId))
        {
            isLoading = false;
            return;
        }

        var trips = await TripService.GetUserTripsAsync(userId);
        stats = BuildDashboardStats(trips);
        achievements = BuildAchievementItems(stats);

        isLoading = false;
    }

    private static DashboardStats BuildDashboardStats(List<TripRecord> trips)
    {
        if (trips.Count == 0)
        {
            return DashboardStats.Empty;
        }

        var totalTrips = trips.Count;
        var totalSpend = trips.Sum(x => x.Price);
        var highestFare = trips.Max(x => x.Price);

        var tripMileageList = trips.Select(GetTripMileage).ToList();
        var totalMileage = tripMileageList.Sum();
        var longestTripMileage = tripMileageList.Max();

        var uniqueRoutesByVia = trips
            .SelectMany(x => x.ViaRouteSegments ?? [])
            .Select(x => x.RouteName?.Trim())
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .Count();

        var routeStatHint = "按经由线路去重";
        var uniqueRoutes = uniqueRoutesByVia;
        if (uniqueRoutes == 0)
        {
            uniqueRoutes = trips
                .Select(x => $"{x.FromStation.Trim()} -> {x.ToStation.Trim()}")
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .Count();
            routeStatHint = "无经由数据时按区间统计";
        }

        var rollingStockTypes = trips
            .SelectMany(x => ExtractRollingStockTypes(x.RollingStock))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();

        var uniqueTrainNumbers = trips
            .Select(x => x.TrainNumber.Trim().ToUpperInvariant())
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .Count();

        var uniqueStations = trips
            .SelectMany(x => new[] { x.FromStation, x.ToStation })
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Select(x => x.Trim())
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .Count();

        var uniqueSeatTypes = trips
            .Where(x => !string.IsNullOrWhiteSpace(x.SeatType))
            .Select(x => x.SeatType!.Trim())
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .Count();

        return new DashboardStats
        {
            TotalTrips = totalTrips,
            TotalSpend = totalSpend,
            HighestFare = highestFare,
            TotalMileageKm = totalMileage,
            LongestTripMileageKm = longestTripMileage,
            UniqueRoutes = uniqueRoutes,
            RouteStatHint = routeStatHint,
            UniqueRollingStockTypes = rollingStockTypes.Count,
            RollingStockRecords = trips.Count(x => !string.IsNullOrWhiteSpace(x.RollingStock)),
            UniqueStations = uniqueStations,
            UniqueTrainNumbers = uniqueTrainNumbers,
            UniqueSeatTypes = uniqueSeatTypes,
            FirstTripDate = trips.Min(x => x.TravelDate),
            LatestTripDate = trips.Max(x => x.TravelDate),
            ExplorerLevel = ResolveExplorerLevel(totalMileage)
        };
    }

    private static List<AchievementItem> BuildAchievementItems(DashboardStats stats)
    {
        return
        [
            BuildCountAchievement("发车达人", "bi bi-ticket-perforated-fill", stats.TotalTrips, [10, 50, 120], "次"),
            BuildCountAchievement("线路探索家", "bi bi-signpost-split-fill", stats.UniqueRoutes, [5, 20, 40], "条"),
            BuildMileageAchievement("里程征服者", "bi bi-geo-alt-fill", stats.TotalMileageKm, [1000m, 5000m, 20000m]),
            BuildCurrencyAchievement("票价记录员", "bi bi-cash-stack", stats.TotalSpend, [1000m, 5000m, 15000m]),
            BuildCountAchievement("车型图鉴", "bi bi-train-front-fill", stats.UniqueRollingStockTypes, [3, 8, 15], "种")
        ];
    }

    private static AchievementItem BuildCountAchievement(string name, string iconClass, int current, int[] targets, string
unit)
    {
        var tier = ResolveTier(current, targets);
        var nextTarget = targets.FirstOrDefault(x => x > current);

        return new AchievementItem
        {
            Name = name,
            IconClass = iconClass,
            TierName = ResolveTierName(tier),
            Unlocked = tier > 0,
            CurrentText = $"当前：{current} {unit}",
            NextTargetText = nextTarget > 0 ? $"下一档：{nextTarget} {unit}" : "已达最高档"
        };
    }

    private static AchievementItem BuildMileageAchievement(string name, string iconClass, decimal current, decimal[]
targets)
    {
        var tier = ResolveTier(current, targets);
        var nextTarget = targets.FirstOrDefault(x => x > current);

        return new AchievementItem
        {
            Name = name,
            IconClass = iconClass,
            TierName = ResolveTierName(tier),
            Unlocked = tier > 0,
            CurrentText = $"当前：{current:N1} km",
            NextTargetText = nextTarget > 0 ? $"下一档：{nextTarget:N0} km" : "已达最高档"
        };
    }

    private static AchievementItem BuildCurrencyAchievement(string name, string iconClass, decimal current, decimal[]
targets)
    {
        var tier = ResolveTier(current, targets);
        var nextTarget = targets.FirstOrDefault(x => x > current);

        return new AchievementItem
        {
            Name = name,
            IconClass = iconClass,
            TierName = ResolveTierName(tier),
            Unlocked = tier > 0,
            CurrentText = $"当前：¥{current:N2}",
            NextTargetText = nextTarget > 0 ? $"下一档：¥{nextTarget:N0}" : "已达最高档"
        };
    }

    private static int ResolveTier(int current, int[] targets)
    {
        var tier = 0;
        foreach (var target in targets)
        {
            if (current >= target)
            {
                tier++;
            }
        }

        return tier;
    }

    private static int ResolveTier(decimal current, decimal[] targets)
    {
        var tier = 0;
        foreach (var target in targets)
        {
            if (current >= target)
            {
                tier++;
            }
        }

        return tier;
    }

    private static string ResolveTierName(int tier)
    {
        return tier switch
        {
            0 => "未点亮",
            1 => "青铜",
            2 => "白银",
            _ => "黄金"
        };
    }

    private static string ResolveExplorerLevel(decimal totalMileageKm)
    {
        if (totalMileageKm >= 20000)
        {
            return "钢轨征服者";
        }

        if (totalMileageKm >= 5000)
        {
            return "干线旅行家";
        }

        if (totalMileageKm >= 1000)
        {
            return "区域通勤者";
        }

        return "见习铁路迷";
    }

    private static decimal GetTripMileage(TripRecord trip)
    {
        if (trip.MileageKm > 0)
        {
            return trip.MileageKm;
        }

        var segmentMileage = (trip.ViaRouteSegments ?? []).Sum(x => x.MileageKm);
        return segmentMileage > 0 ? segmentMileage : 0m;
    }

    private static IEnumerable<string> ExtractRollingStockTypes(string? rollingStock)
    {
        if (string.IsNullOrWhiteSpace(rollingStock))
        {
            return [];
        }

        var results = new List<string>();
        var tokens = rollingStock.Split(['、', '，', ',', '/', ';', '；', '+', ' '], StringSplitOptions.RemoveEmptyEntries |
StringSplitOptions.TrimEntries);

        foreach (var token in tokens)
        {
            var head = token.Split(['-', '(', '（', '#'], 2)[0];
            var normalized = new string(head.Where(char.IsLetterOrDigit).ToArray()).ToUpperInvariant();
            if (normalized.Any(char.IsLetter))
            {
                results.Add(normalized);
            }
        }

        return results;
    }

    private static string GetAvatarInitial(string? displayName)
    {
        if (string.IsNullOrWhiteSpace(displayName))
        {
            return "轨";
        }

        return displayName.Trim()[0].ToString().ToUpperInvariant();
    }

    private sealed class DashboardStats
    {
        public static DashboardStats Empty { get; } = new();

        public int TotalTrips { get; init; }

        public decimal TotalSpend { get; init; }

        public decimal HighestFare { get; init; }

        public decimal TotalMileageKm { get; init; }

        public decimal LongestTripMileageKm { get; init; }

        public int UniqueRoutes { get; init; }

        public string RouteStatHint { get; init; } = "按经由线路去重";

        public int UniqueRollingStockTypes { get; init; }

        public int RollingStockRecords { get; init; }

        public int UniqueStations { get; init; }

        public int UniqueTrainNumbers { get; init; }

        public int UniqueSeatTypes { get; init; }

        public DateOnly? FirstTripDate { get; init; }

        public DateOnly? LatestTripDate { get; init; }

        public string ExplorerLevel { get; init; } = "见习铁路迷";
    }

    private sealed class AchievementItem
    {
        public string Name { get; init; } = string.Empty;

        public string IconClass { get; init; } = string.Empty;

        public string TierName { get; init; } = string.Empty;

        public bool Unlocked { get; init; }

        public string CurrentText { get; init; } = string.Empty;

        public string NextTargetText { get; init; } = string.Empty;
    }
}
