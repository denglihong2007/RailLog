@page "/"
@using System.Security.Claims
@using RailLog.Components
@using RailLog.Services
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject TripService TripService

<PageTitle>首页 - 轨记</PageTitle>

<div class="home-dashboard container py-2">
    @if (isLoading)
    {
        <div class="dashboard-loading text-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="text-muted mt-3 mb-0">正在整理你的行程成就...</p>
        </div>
    }
    else if (!isAuthenticated)
    {
        <section class="dashboard-empty card border-0 shadow-sm">
            <div class="card-body py-4">
                <h2 class="h4 mb-2">登录后查看你的铁路成就</h2>
                <p class="text-muted mb-3">成就墙会展示你的线路、里程、车型和票价统计。</p>
                <a href="Account/Login" class="btn btn-primary">去登录</a>
            </div>
        </section>
    }
    else
    {
        <ProfileDashboardPanel Stats="stats"                               Achievements="achievements"                               IsOwnerView="true"                               SubjectName="你"
                               AddFirstTripUrl="/add-trip" />
    }
</div>

@code {
    private bool isLoading = true;
    private bool isAuthenticated;
    private DashboardStats stats = DashboardStats.Empty;
    private List<AchievementItem> achievements = [];

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        isAuthenticated = user.Identity?.IsAuthenticated == true;

        if (!isAuthenticated)
        {
            isLoading = false;
            return;
        }

        var userId = user.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        if (string.IsNullOrWhiteSpace(userId))
        {
            isLoading = false;
            return;
        }

        var trips = await TripService.GetUserTripsAsync(userId);
        stats = ProfileDashboardBuilder.BuildDashboardStats(trips);
        achievements = ProfileDashboardBuilder.BuildAchievementItems(stats);

        isLoading = false;
    }
}