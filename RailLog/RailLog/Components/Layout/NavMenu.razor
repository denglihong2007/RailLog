@implements IDisposable
@using System.Security.Claims
@using Microsoft.EntityFrameworkCore
@using RailLog.Data

@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IDbContextFactory<ApplicationDbContext> DbContextFactory

<div class="top-row">
    <a class="navbar-brand" href="">
        <span class="brand-mark" aria-hidden="true">
            <img src="icon_black.png" alt="轨记 Logo" />
        </span>
        <span class="brand-text">
            <strong>轨记</strong>
            <small>RailLog</small>
        </span>
    </a>
</div>

<input type="checkbox" title="导航菜单" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="rail-nav">
        <section class="nav-section">
            <p class="nav-section__title">导航</p>

            <div class="nav-item">
                <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                    <i class="bi bi-house-door"></i>
                    <span>首页</span>
                </NavLink>
            </div>

            <div class="nav-item">
                <NavLink class="nav-link" href="leaderboard">
                    <i class="bi bi-trophy"></i>
                    <span>排行榜</span>
                </NavLink>
            </div>

            <div class="nav-item">
                <NavLink class="nav-link" href="my-trips">
                    <i class="bi bi-train-front"></i>
                    <span>运转日志</span>
                </NavLink>
            </div>

            <div class="nav-item">
                <NavLink class="nav-link" href="add-trip">
                    <i class="bi bi-pen"></i>
                    <span>记录行程</span>
                </NavLink>
            </div>

            <div class="nav-item">
                <NavLink class="nav-link" href="about">
                    <i class="bi bi-info-circle"></i>
                    <span>关于</span>
                </NavLink>
            </div>
        </section>

        <section class="nav-section">
            <p class="nav-section__title">更多功能</p>
            <div class="nav-item">
                <a class="nav-link" href="https://apps.microsoft.com/detail/9n4xhrrmph8v?referrer=raillog&hl=zh-CN"
                       target="_blank" rel="noopener noreferrer">
                    <i class="bi bi-pc-display"></i>
                    <span>车站模拟</span>
                </a>
            </div>

            <div class="nav-item">
                <a class="nav-link" href="https://railgo.dev" target="_blank" rel="noopener noreferrer">
                    <i class="bi bi-search-heart"></i>
                    <span>铁路快查</span>
                </a>
            </div>
        </section>

        <AuthorizeView>
            <Authorized>
                <section class="profile-card profile-card--bottom" aria-label="当前用户信息">
                    @if (string.IsNullOrWhiteSpace(userAvatarUrl))
                    {
                        <span class="profile-card__avatar">@GetAvatarInitial(userDisplayName)</span>
                    }
                    else
                    {
                        <img class="profile-card__avatar profile-card__avatar--image" src="@userAvatarUrl"
                             alt="@(userDisplayName + " 的头像")" @onerror="OnAvatarImageError" />
                    }
                    <span class="profile-card__meta">
                        <span class="profile-card__name">@userDisplayName</span>
                        <span class="profile-card__hint">已登录</span>
                    </span>
                    <span class="profile-card__actions">
                        <a class="profile-card__icon-btn" href="Account/Manage" aria-label="个人资料设置" title="个人资料设置">
                            <i class="bi bi-gear" aria-hidden="true"></i>
                        </a>
                        <form class="profile-logout-form" action="Account/Logout" method="post">
                            <AntiforgeryToken />
                            <input type="hidden" name="ReturnUrl" value="@currentUrl" />
                            <button type="submit" class="profile-card__icon-btn" aria-label="退出登录" title="退出登录">
                                <i class="bi bi-box-arrow-right" aria-hidden="true"></i>
                            </button>
                        </form>
                    </span>
                </section>
            </Authorized>
            <NotAuthorized>
                <section class="nav-section">
                    <p class="nav-section__title">账户</p>

                    <div class="nav-item">
                        <NavLink class="nav-link" href="Account/Register">
                            <i class="bi bi-person"></i>
                            <span>注册</span>
                        </NavLink>
                    </div>

                    <div class="nav-item">
                        <NavLink class="nav-link" href="Account/Login">
                            <i class="bi bi-person-badge"></i>
                            <span>登录</span>
                        </NavLink>
                    </div>
                </section>
            </NotAuthorized>
        </AuthorizeView>
    </nav>
</div>

@code {
    private string? currentUrl;
    private string? currentUserId;
    private string? userDisplayName;
    private string? userAvatarUrl;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var principal = authState.User;
        var userId = principal.FindFirstValue(ClaimTypes.NameIdentifier);

        if (string.IsNullOrWhiteSpace(userId))
        {
            currentUserId = null;
            userDisplayName = principal.Identity?.Name ?? "游客";
            userAvatarUrl = null;
            return;
        }

        currentUserId = userId;

        await using var context = await DbContextFactory.CreateDbContextAsync();
        var userProfile = await context.Users
            .AsNoTracking()
            .Where(x => x.Id == userId)
            .Select(x => new
            {
                x.DisplayName,
                x.UserName,
                x.AvatarUrl
            })
            .FirstOrDefaultAsync();

        userDisplayName = ResolveDisplayName(userProfile?.DisplayName, userProfile?.UserName, principal.Identity?.Name);
        userAvatarUrl = NormalizeAvatarUrl(userProfile?.AvatarUrl);
    }

    protected override void OnInitialized()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    private static string GetAvatarInitial(string? displayName)
    {
        if (string.IsNullOrWhiteSpace(displayName))
        {
            return "轨";
        }

        return displayName.Trim()[0].ToString().ToUpperInvariant();
    }

    private void OnAvatarImageError(EventArgs _)
    {
        userAvatarUrl = null;
    }

    private static string ResolveDisplayName(string? displayName, string? userName, string? fallback)
    {
        if (!string.IsNullOrWhiteSpace(displayName))
        {
            return displayName;
        }

        if (!string.IsNullOrWhiteSpace(userName))
        {
            return userName;
        }

        return fallback ?? "游客";
    }

    private static string? NormalizeAvatarUrl(string? avatarUrl)
    {
        if (string.IsNullOrWhiteSpace(avatarUrl))
        {
            return null;
        }

        return avatarUrl.Trim();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}
