@namespace RailLog.Client.Components
@using Microsoft.AspNetCore.Components.Forms
@using RailLog.Shared.Models
@inject NavigationManager NavigationManager

<div class="trip-ticket-panel">
    @if (Trips == null)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-3 mb-0 text-muted">@LoadingText</p>
        </div>
    }
    else
    {
        <section class="ticket-search card border-0 shadow-sm mb-4">
            <div class="card-body">
                <div class="row g-3 align-items-end">
                    <div class="col-lg-4 col-md-6">
                        <label for="@KeywordInputId" class="form-label">关键字</label>
                        <input id="@KeywordInputId" class="form-control" @bind="keyword" placeholder="车次 / 站点 / 席位 / 本务" />
                    </div>
                    <div class="col-lg-2 col-md-3 col-sm-6">
                        <label for="@DateFromInputId" class="form-label">起始日期</label>
                        <InputDate id="@DateFromInputId" class="form-control" @bind-Value="dateFrom" />
                    </div>
                    <div class="col-lg-2 col-md-3 col-sm-6">
                        <label for="@DateToInputId" class="form-label">截止日期</label>
                        <InputDate id="@DateToInputId" class="form-control" @bind-Value="dateTo" />
                    </div>
                    <div class="col-lg-2 col-md-4 col-sm-6">
                        <label for="@SeatFilterInputId" class="form-label">席别</label>
                        <InputSelect id="@SeatFilterInputId" class="form-select" @bind-Value="seatTypeFilter">
                            <option value="">全部</option>
                            @foreach (var seat in seatTypeOptions)
                            {
                                <option value="@seat">@seat</option>
                            }
                        </InputSelect>
                    </div>
                    <div class="col-lg-2 col-md-4 col-sm-6">
                        <label for="@SortInputId" class="form-label">排序</label>
                        <InputSelect id="@SortInputId" class="form-select" @bind-Value="sortMode">
                            <option value="date_desc">日期新到旧</option>
                            <option value="date_asc">日期旧到新</option>
                            <option value="price_desc">票价高到低</option>
                            <option value="price_asc">票价低到高</option>
                        </InputSelect>
                    </div>
                    <div class="col-lg-12 col-md-4">
                        <button class="btn btn-outline-secondary" @onclick="ResetFilters">重置筛选</button>
                        <span class="ms-3 text-muted small">共 @filteredTrips.Count @TicketCountUnit</span>
                    </div>
                </div>
            </div>
        </section>

        @if (!Trips.Any())
        {
            <div class="alert alert-info mb-0">@EmptyText</div>
        }
        else if (!filteredTrips.Any())
        {
            <div class="alert alert-warning mb-0">@EmptyFilterText</div>
        }
        else
        {
            <div class="ticket-grid">
                @foreach (var trip in filteredTrips)
                {
                    <a class="@GetTicketClass(trip)" href="@BuildTripDetailsUrl(trip.Id)">
                        <span class="ticket-bump ticket-bump-left-top" aria-hidden="true"></span>
                        <span class="ticket-bump ticket-bump-left-bottom" aria-hidden="true"></span>
                        <span class="ticket-bump ticket-bump-right-top" aria-hidden="true"></span>
                        <span class="ticket-bump ticket-bump-right-bottom" aria-hidden="true"></span>

                        <div class="ticket-id-row">
                            <span class="trip-id">@FormatTripId(trip.Id)</span>
                        </div>

                        <div class="ticket-route">
                            <div class="station station-from">@trip.FromStation</div>
                            <div class="route-arrow">
                                <span class="train-number">@trip.TrainNumber</span>
                                <span class="route-line" aria-hidden="true"></span>
                            </div>
                            <div class="station station-to">@trip.ToStation</div>
                        </div>

                        <div class="ticket-row">
                            <div class="ticket-left">
                                <span class="field-value">@trip.TravelDate.ToString("yyyy年MM月dd日")
                                    @(trip.DepartureTime.HasValue? FormatDepartureTime(trip.DepartureTime) +"开" : "")</span>
                                </div>
                                <div class="ticket-right">
                                    <span class="field-value">@(string.IsNullOrWhiteSpace(trip.SeatNumber) ? "未填" :
                                                                                                                                                                                                                                                                                                                                                                                                trip.SeatNumber)</span>
                                    </div>
                                </div>

                                <div class="ticket-row">
                                    <div class="ticket-left">
                                        <span class="field-value">¥@trip.Price.ToString("0.##")元</span>
                                    </div>
                                    <div class="ticket-right">
                                        <span class="field-value">@(string.IsNullOrWhiteSpace(trip.SeatType) ? "未填" : trip.SeatType)</span>
                                    </div>
                                </div>

                                <div class="ticket-bottom">
                                    <div class="ticket-passenger">
                                        <div class="passenger-name">@GetPassengerName()</div>
                                        <div class="ticket-note-box">@GetNoteText(trip.Notes)</div>
                                    </div>
                                    <div class="ticket-qr">
                                        <img src="@BuildQrCodeImageUrl(trip.Id)" alt="行程详情二维码" loading="lazy" />
                                    </div>
                                </div>
                            </a>
                        }
                    </div>
                }
            }
        </div>

@code {
    [Parameter]
    public IReadOnlyList<TripRecordDto>? Trips { get; set; }

    [Parameter]
    public string LoadingText { get; set; } = "正在加载行程记录...";

    [Parameter]
    public string EmptyText { get; set; } = "暂无行程记录。";

    [Parameter]
    public string EmptyFilterText { get; set; } = "没有匹配的运转记录，试试放宽筛选条件。";

    [Parameter]
    public string TicketCountUnit { get; set; } = "张车票";

    [Parameter]
    public string DetailButtonText { get; set; } = "详细信息";

    [Parameter]
    public bool UsePublicTripDetails { get; set; }

    [Parameter]
    public string? PassengerName { get; set; }

    private string keyword = string.Empty;
    private DateOnly? dateFrom;
    private DateOnly? dateTo;
    private string seatTypeFilter = string.Empty;
    private string sortMode = "date_desc";
    private List<string> seatTypeOptions = [];

    private List<TripRecordDto> filteredTrips => ApplyFilters();

    private string ComponentKey { get; } = Guid.NewGuid().ToString("N");
    private string KeywordInputId => $"trip-keyword-{ComponentKey}";
    private string DateFromInputId => $"trip-date-from-{ComponentKey}";
    private string DateToInputId => $"trip-date-to-{ComponentKey}";
    private string SeatFilterInputId => $"trip-seat-filter-{ComponentKey}";
    private string SortInputId => $"trip-sort-{ComponentKey}";

    protected override void OnParametersSet()
    {
        if (Trips is null)
        {
            seatTypeOptions = [];
            return;
        }

        seatTypeOptions = Trips
            .Where(x => !string.IsNullOrWhiteSpace(x.SeatType))
            .Select(x => x.SeatType!.Trim())
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(x => x)
            .ToList();

        if (!string.IsNullOrWhiteSpace(seatTypeFilter) &&
            !seatTypeOptions.Any(x => string.Equals(x, seatTypeFilter, StringComparison.OrdinalIgnoreCase)))
        {
            seatTypeFilter = string.Empty;
        }
    }

    private List<TripRecordDto> ApplyFilters()
    {
        if (Trips is null)
        {
            return [];
        }

        IEnumerable<TripRecordDto> query = Trips;

        if (!string.IsNullOrWhiteSpace(keyword))
        {
            var key = keyword.Trim();
            query = query.Where(x =>
                x.TrainNumber.Contains(key, StringComparison.OrdinalIgnoreCase) ||
                x.FromStation.Contains(key, StringComparison.OrdinalIgnoreCase) ||
                x.ToStation.Contains(key, StringComparison.OrdinalIgnoreCase) ||
                (!string.IsNullOrWhiteSpace(x.SeatType) && x.SeatType.Contains(key, StringComparison.OrdinalIgnoreCase)) ||
                (!string.IsNullOrWhiteSpace(x.SeatNumber) && x.SeatNumber.Contains(key, StringComparison.OrdinalIgnoreCase)) ||
                (!string.IsNullOrWhiteSpace(x.RollingStock) && x.RollingStock.Contains(key, StringComparison.OrdinalIgnoreCase)));
        }

        if (dateFrom.HasValue)
        {
            query = query.Where(x => x.TravelDate >= dateFrom.Value);
        }

        if (dateTo.HasValue)
        {
            query = query.Where(x => x.TravelDate <= dateTo.Value);
        }

        if (!string.IsNullOrWhiteSpace(seatTypeFilter))
        {
            query = query.Where(x => string.Equals(x.SeatType?.Trim(), seatTypeFilter, StringComparison.OrdinalIgnoreCase));
        }

        query = sortMode switch
        {
            "date_asc" => query
                .OrderBy(x => x.TravelDate)
                .ThenByDescending(x => x.DepartureTime.HasValue)
                .ThenBy(x => x.DepartureTime)
                .ThenBy(x => x.TrainNumber),
            "price_desc" => query.OrderByDescending(x => x.Price).ThenByDescending(x => x.TravelDate),
            "price_asc" => query.OrderBy(x => x.Price).ThenByDescending(x => x.TravelDate),
            _ => query
                .OrderByDescending(x => x.TravelDate)
                .ThenByDescending(x => x.DepartureTime.HasValue)
                .ThenByDescending(x => x.DepartureTime)
                .ThenBy(x => x.TrainNumber)
        };

        return query.ToList();
    }

    private static string FormatDepartureTime(TimeOnly? departureTime)
    {
        return departureTime.HasValue ? departureTime.Value.ToString("HH:mm") : "未填";
    }

    private string BuildTripDetailsUrl(int tripId)
    {
        return UsePublicTripDetails
            ? $"/trip-details/{tripId}?public=true"
            : $"/trip-details/{tripId}";
    }

    private string BuildTripDetailsAbsoluteUrl(int tripId)
    {
        var absolute = NavigationManager.ToAbsoluteUri(BuildTripDetailsUrl(tripId));
        return absolute.ToString();
    }

    private string BuildQrCodeImageUrl(int tripId)
    {
        var target = Uri.EscapeDataString(BuildTripDetailsAbsoluteUrl(tripId));
        if (!target.EndsWith($"?public=true", StringComparison.OrdinalIgnoreCase))
        {
            target += "?public=true";
        }
        return $"https://quickchart.io/qr?size=120&margin=0&dark=1A3B58&light=0000&text={target}";
    }

    private static string FormatTripId(int tripId) => tripId.ToString("D7");

    private static string GetTicketClass(TripRecordDto trip)
    {
        return trip.IsRailTrip ? "trip-ticket" : "trip-ticket trip-ticket-non-rail";
    }

    private string GetPassengerName()
    {
        return string.IsNullOrWhiteSpace(PassengerName) ? "RailLog用户" : PassengerName.Trim();
    }

    private static string GetNoteText(string? note)
    {
        return string.IsNullOrWhiteSpace(note) ? "无备注" : note.Trim();
    }

    private void ResetFilters()
    {
        keyword = string.Empty;
        dateFrom = null;
        dateTo = null;
        seatTypeFilter = string.Empty;
        sortMode = "date_desc";
    }
}
