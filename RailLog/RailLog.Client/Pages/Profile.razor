@page "/profile/{UserId}"
@rendermode InteractiveWebAssembly
@using System.Net
@using RailLog.Shared.Models
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject HttpClient HttpClient

<PageTitle>个人主页 - 轨记</PageTitle>
<PageHeader Title="个人主页" Subtitle="整合成就总览与全部行程记录" IconClass="bi bi-person-vcard" />

<div class="profile-page container pb-3">
    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="text-muted mt-3 mb-0">正在加载该用户主页...</p>
        </div>
    }
    else if (!isAuthenticated)
    {
        <section class="dashboard-empty card border-0 shadow-sm">
            <div class="card-body py-4">
                <h2 class="h4 mb-2">登录后查看用户个人主页</h2>
                <p class="text-muted mb-3">个人主页包含成就概览与全部行程记录。</p>
                <a href="/Account/Login" class="btn btn-primary">去登录</a>
            </div>
        </section>
    }
    else if (profile is null)
    {
        <section class="dashboard-empty card border-0 shadow-sm">
            <div class="card-body py-4">
                <h2 class="h4 mb-2">未找到该用户</h2>
                <p class="text-muted mb-3">请返回排行榜重新选择用户。</p>
                <a href="/leaderboard" class="btn btn-outline-primary">返回排行榜</a>
            </div>
        </section>
    }
    else
    {
        <section class="profile-summary card border-0 shadow-sm">
            <div class="card-body">
                <div class="profile-summary__main">
                    <span class="profile-summary__avatar">
                        @if (!string.IsNullOrWhiteSpace(profile.AvatarUrl))
                        {
                            <img src="@profile.AvatarUrl" alt="@($"{GetProfileDisplayName(profile)}头像")" />
                        }
                        else
                        {
                            <span>@GetAvatarInitial(GetProfileDisplayName(profile))</span>
                        }
                    </span>
                    <div>
                        <h2 class="h4 mb-1">@GetProfileDisplayName(profile)</h2>
                        <p class="profile-summary__bio mb-1">@GetBioText(profile.Bio)</p>
                        @if (profile.ShowEmail)
                        {
                            <p class="profile-summary__contact mb-0">邮箱：@(string.IsNullOrWhiteSpace(profile.Email) ? "未设置" :
                                                                                                                                                                                                                                                                                                                                                                                                                        profile.Email)</p>
                            }
                        </div>
                    </div>
                </div>
            </section>

            <div class="mt-3">
                <ProfileDashboardPanel Stats="stats" Achievements="achievements" IsOwnerView="false"
                                       SubjectName="@GetProfileDisplayName(profile)" />
            </div>

            <section class="profile-trips mt-4">
                <div class="achievement-wall__header mb-3">
                    <h3 class="mb-0">全部行程</h3>
                </div>
                <TripTicketPanel Trips="trips" LoadingText="正在加载该用户行程记录..." EmptyText="该用户还没有录入行程记录。"
                                 EmptyFilterText="该筛选条件下暂无行程记录。" TicketCountUnit="条记录" DetailButtonText="查看详情" UsePublicTripDetails="true"
                                 PassengerName="@GetProfileDisplayName(profile)" />
            </section>
        }
    </div>

@code {
    [Parameter]
    public string UserId { get; set; } = string.Empty;

    private bool isLoading = true;
    private bool isAuthenticated;
    private bool isOwnerProfile;
    private PublicUserProfileDto? profile;
    private DashboardStatsDto stats = DashboardStatsDto.Empty;
    private List<AchievementItemDto> achievements = [];
    private List<TripRecordDto>? trips;

    protected override async Task OnParametersSetAsync()
    {
        if (!OperatingSystem.IsBrowser())
        {
            return;
        }
        isLoading = true;
        isAuthenticated = false;
        profile = null;
        stats = DashboardStatsDto.Empty;
        achievements = [];
        trips = [];

        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        isAuthenticated = user.Identity?.IsAuthenticated == true;
        isOwnerProfile = string.Equals(user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value, UserId,
StringComparison.Ordinal);

        if (!isAuthenticated || string.IsNullOrWhiteSpace(UserId))
        {
            isLoading = false;
            return;
        }

        try
        {
            var response = await HttpClient.GetFromJsonAsync<ProfilePageDto>($"api/profile/{Uri.EscapeDataString(UserId)}");
            if (response is null)
            {
                isLoading = false;
                return;
            }

            profile = response.Profile;
            stats = response.Stats;
            achievements = response.Achievements;
            trips = response.Trips;
        }
        catch (HttpRequestException ex) when (ex.StatusCode == HttpStatusCode.NotFound)
        {
            profile = null;
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Failed to load profile page for user {UserId}: {ex}");
            profile = null;
        }

        isLoading = false;
    }

    private static string GetAvatarInitial(string? displayName)
    {
        if (string.IsNullOrWhiteSpace(displayName))
        {
            return "轨";
        }

        return displayName.Trim()[0].ToString().ToUpperInvariant();
    }

    private static string GetBioText(string? bio)
    {
        return string.IsNullOrWhiteSpace(bio)
            ? "这个人很神秘，还没有填写个人简介。"
            : bio.Trim();
    }

    private string GetProfileDisplayName(PublicUserProfileDto source)
    {
        if (isOwnerProfile && !string.IsNullOrWhiteSpace(source.UserName))
        {
            return source.UserName.Trim();
        }

        return string.IsNullOrWhiteSpace(source.DisplayName)
            ? "匿名旅客"
            : source.DisplayName.Trim();
    }
}