@page "/about"
@rendermode InteractiveWebAssembly

<PageTitle>关于 - 轨记</PageTitle>

<div class="about-page container py-3">
    <section class="about-hero card border-0 shadow-sm">
        <div class="card-body p-4 p-md-5">
            <div class="about-hero__content">
                <div class="about-hero__title">
                    <img class="about-logo" src="icon_black.png" alt="轨记 Logo" />
                    <div>
                        <p class="about-kicker mb-1">RAILLOG PROJECT</p>
                        <h1 class="h2 mb-1">轨记 RailLog</h1>
                        <p class="text-muted mb-0">记录每一段铁道旅途，沉淀属于你的运转足迹。</p>
                    </div>
                </div>
                <div class="about-badge-list">
                    <span class="about-badge"><i class="bi bi-train-front"></i> 运转日志</span>
                    <span class="about-badge"><i class="bi bi-trophy"></i> 排行系统</span>
                    <span class="about-badge"><i class="bi bi-people"></i> 同行交集</span>
                </div>
            </div>
            <div class="about-hero__art" aria-hidden="true">
                <img src="favicon.png" alt="" />
            </div>
        </div>
    </section>

    <section class="about-grid mt-3">
        <article class="about-panel card border-0 shadow-sm">
            <div class="card-body p-4">
                <h2 class="h5 mb-3">开发者</h2>
                <div class="about-dev-list">
                    <a class="about-dev" href="https://github.com/denglihong2007" target="_blank"
                           rel="noopener noreferrer">
                        <img src="https://github.com/denglihong2007.png" alt="电排骨头像" />
                        <span>电排骨</span>
                    </a>
                    <a class="about-dev" href="https://github.com/SS7D" target="_blank" rel="noopener noreferrer">
                        <img src="https://github.com/SS7D.png" alt="SS7D头像" />
                        <span>SS7D</span>
                    </a>
                </div>
            </div>
        </article>

        <article class="about-panel card border-0 shadow-sm">
            <div class="card-body p-4">
                <h2 class="h5 mb-3">项目信息</h2>
                <ul class="about-links mb-0">
                    <li>
                        <i class="bi bi-heart-fill"></i>
                        <a href="https://afdian.com/a/CRSim" target="_blank" rel="noopener noreferrer">爱发电支持</a>
                    </li>
                    <li>
                        <i class="bi bi-github"></i>
                        <a href="https://github.com/denglihong2007/RailLog" target="_blank"
                           rel="noopener noreferrer">开源仓库</a>
                    </li>
                    <li>
                        <i class="bi bi-award"></i>
                        <span>特别鸣谢：RailGo 项目</span>
                    </li>
                    <li>
                        <i class="bi bi-gem"></i>
                        <span>赞助者：冰镇杨梅汁儿</span>
                    </li>
                </ul>
            </div>
        </article>
    </section>
</div>