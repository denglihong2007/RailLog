@page "/add-trip"
@page "/edit-trip/{TripId:int}"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using System.Net
@using System.Net.Http.Headers
@using System.Text.Json
@using RailLog.Shared.Models
@attribute [Authorize]
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@inject NavigationManager Nav
@inject HttpClient HttpClient

<PageTitle>@(IsEditMode ? "编辑运转记录 - 轨记" : "新增运转记录 - 轨记")</PageTitle>

<PageHeader Title="@(IsEditMode ? "编辑运转记录" : "新增运转记录")" IconClass="bi bi-pen" />

<EditForm class="mb-4" Model="model" OnValidSubmit="HandleSubmit" FormName="AddTripForm">
    <DataAnnotationsValidator />
    <div class="mb-4">
        <SectionHeader Title="车票识别" />
        <div class="ticket-ocr">
            <div class="row g-3 align-items-center">
                <div class="col-lg-8 ticket-ocr__actions">
                    <InputFile id="ocr-file-input" class="d-none" OnChange="OnOcrFileSelected"
                               accept=".jpg,.jpeg,.png,.bmp,image/jpeg,image/png,image/bmp,image/jpg" />
                    <InputFile id="ocr-camera-input" class="d-none" OnChange="OnOcrFileSelected" accept="image/*"
                               capture="environment" />
                    <label for="ocr-file-input" class="btn btn-outline-secondary mb-0">
                        <i class="bi bi-folder2-open me-1"></i>选择文件
                    </label>
                    <label for="ocr-camera-input" class="btn btn-outline-secondary mb-0">
                        <i class="bi bi-camera me-1"></i>打开相机
                    </label>
                    <div class="form-text w-100">
                        可选择本地图片，或在移动端直接调用相机拍照后识别。
                    </div>
                    @if (ocrImageFile is not null)
                    {
                        <div class="small text-muted mt-1">
                            已选择：@ocrImageFile.Name (@((ocrImageFile.Size / 1024.0).ToString("0.#")) KB)
                        </div>
                    }
                </div>
                <div class="col-lg-4">
                    <button type="button" class="btn btn-outline-primary w-100" @onclick="RecognizeTicketAsync"
                            disabled="@(isOcrProcessing || ocrImageFile is null)">
                        @if (isOcrProcessing)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                            <span>识别中...</span>
                        }
                        else
                        {
                            <span><i class="bi bi-camera me-1"></i>识别并填充</span>
                        }
                    </button>
                </div>
            </div>
            @if (!string.IsNullOrWhiteSpace(ocrStatusMessage))
            {
                <div class="alert @(ocrStatusIsError ? "alert-danger" : "alert-success") py-2 mb-0 mt-3">
                    @ocrStatusMessage
                </div>
            }
        </div>
    </div>

    <div class="mb-4">
        <SectionHeader Title="基本信息" />
        <div class="row g-3">
            <div class="col-md-4">
                <div class="form-floating mb-3">
                    <input type="text" id="trainNumber" class="form-control" placeholder="如: G89"
                           list="train-number-options" value="@model!.TrainNumber" @oninput="OnTrainInputChanged"
                           @onblur="OnTrainInputCompleted" />
                    <datalist id="train-number-options">
                        @foreach (var train in trainSuggestions)
                        {
                            <option value="@train"></option>
                        }
                    </datalist>
                    <label for="trainNumber" class="form-label">车次</label>
                    <ValidationMessage For="@(() => model.TrainNumber)" class="text-danger small" />
                </div>
            </div>
            <div class="col-md-4">
                <div class="form-floating mb-3">
                    <InputDate @bind-Value="model.TravelDate" @bind-Value:after="OnTravelDateChanged" id="travelDate"
                               class="form-control" />
                    <label for="travelDate" class="form-label">乘车日期</label>
                    <ValidationMessage For="@(() => model.TravelDate)" class="text-danger small" />
                </div>
            </div>
            <div class="col-md-4">
                <div class="form-floating mb-3">
                    <InputText @bind-Value="model.RollingStock" id="rollingStock" class="form-control"
                               placeholder="如: CR400BF-5033" />
                    <label for="rollingStock" class="form-label">车底/本务</label>
                    <ValidationMessage For="@(() => model.RollingStock)" class="text-danger small" />
                </div>
            </div>
        </div>
    </div>

    <div class="mb-4">
        <SectionHeader Title="路线详情" />
        <div class="row g-3 align-items-center">
            <div class="col-md-5">
                <div class="p-3 bg-light rounded-3">
                    <div class="form-floating mb-2">
                        <input type="text" id="fromStation" class="form-control" list="station-options"
                               placeholder="如：北京西" value="@model!.FromStation" @oninput="OnFromStationChanged"
                               @onblur="OnStationInputCompleted" />
                        <label for="fromStation">出发地</label>
                        <ValidationMessage For="@(() => model.FromStation)" class="text-danger small" />
                    </div>
                    <div class="form-floating">
                        <input type="time" @bind="model.DepartureTime" id="departureTime" class="form-control" />
                        <label for="departureTime">出发时间</label>
                        <ValidationMessage For="@(() => model.DepartureTime)" class="text-danger small" />
                    </div>
                </div>
            </div>
            <div class="col-md-2 d-flex justify-content-center">
                <div class="text-center text-muted small py-2">
                    <div class="d-flex flex-column align-items-center">
                        <i class="bi bi-arrow-right fs-3 d-none d-md-block" aria-hidden="true"></i>
                        <i class="bi bi-arrow-down fs-3 d-block d-md-none" aria-hidden="true"></i>
                    </div>
                </div>
            </div>
            <div class="col-md-5">
                <div class="p-3 bg-light rounded-3">
                    <div class="form-floating mb-2">
                        <input type="text" id="toStation" class="form-control" list="station-options"
                               placeholder="如：西安北" value="@model!.ToStation" @oninput="OnToStationChanged"
                               @onblur="OnStationInputCompleted" />
                        <datalist id="station-options">
                            @foreach (var station in stationSuggestions)
                            {
                                <option value="@station"></option>
                            }
                        </datalist>
                        <label for="toStation">目的地</label>
                        <ValidationMessage For="@(() => model.ToStation)" class="text-danger small" />
                    </div>

                    <div class="form-floating">
                        <input type="time" @bind="model.ArrivalTime" id="arrivalTime" class="form-control" />
                        <label for="arrivalTime">到达时间</label>
                        <ValidationMessage For="@(() => model.ArrivalTime)" class="text-danger small" />
                    </div>
                </div>
            </div>
            <div class="col-12">
                <div class="form-floating">
                    <InputNumber @bind-Value="model.MileageKm" id="mileageKm" class="form-control" step="0.1"
                                 placeholder="如：1216.5" />
                    <label for="mileageKm">里程 (km)</label>
                    <ValidationMessage For="@(() => model.MileageKm)" class="text-danger small" />
                </div>
            </div>
            <div class="col-12">
                <div class="via-editor">
                    <div class="via-editor__header">
                        <label class="form-label mb-0">经由线路</label>
                        <div class="d-flex gap-2">
                            <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="AddViaSegment">
                                新增分段
                            </button>
                            <button type="button" class="btn btn-outline-info btn-sm"
                                    @onclick="FillMileageFromViaSegments">
                                汇总里程
                            </button>
                            <button type="button" class="btn btn-outline-primary btn-sm"
                                    @onclick="ComputeShortestViaRoutesAsync">
                                计算最短经由
                            </button>
                        </div>
                    </div>
                    <div class="mt-2">
                        @if (model?.ViaRouteSegments == null || model.ViaRouteSegments.Count == 0)
                        {
                            <div class="via-editor__empty">暂无经由分段</div>
                        }
                        else
                        {
                            <div class="vstack gap-2">
                                @for (var i = 0; i < model.ViaRouteSegments.Count; i++)
                                {
                                    var idx = i;
                                    var segment = model.ViaRouteSegments[i];
                                    var segmentStationOptionsId = GetSegmentStationDatalistId(idx);
                                    var segmentStationOptions = GetSegmentStationSuggestions(segment);
                                    <div class="via-segment">
                                        <div class="row g-2 align-items-end">
                                            <div class="col-md-3">
                                                <label class="form-label mb-1 small">线路</label>
                                                <input class="form-control form-control-sm" list="segment-route-options"
                                                       value="@segment.RouteName"
                                                       @oninput="async e => await OnSegmentRouteChangedAsync(idx, e.Value?.ToString())" />
                                            </div>
                                            <div class="col-md-3">
                                                <label class="form-label mb-1 small">该线起点</label>
                                                <input class="form-control form-control-sm" list="@segmentStationOptionsId"
                                                       value="@segment.FromStation"
                                                       @oninput="async e => await OnSegmentStationChangedAsync(idx, true, e.Value?.ToString())" />
                                            </div>
                                            <div class="col-md-3">
                                                <label class="form-label mb-1 small">该线终点</label>
                                                <input class="form-control form-control-sm" list="@segmentStationOptionsId"
                                                       value="@segment.ToStation"
                                                       @oninput="async e => await OnSegmentStationChangedAsync(idx, false, e.Value?.ToString())" />
                                            </div>
                                            <div class="col-md-2">
                                                <label class="form-label mb-1 small">里程</label>
                                                <div class="via-segment__mileage">@segment.MileageKm km</div>
                                            </div>
                                            <div class="col-md-1">
                                                <button type="button" class="btn btn-outline-danger btn-sm w-100"
                                                        @onclick="() => RemoveViaSegment(idx)">
                                                    删除
                                                </button>
                                            </div>
                                        </div>
                                        <datalist id="@segmentStationOptionsId">
                                            @foreach (var station in segmentStationOptions)
                                            {
                                                <option value="@station"></option>
                                            }
                                        </datalist>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                    <datalist id="segment-route-options">
                        @foreach (var route in segmentRouteNameSuggestions)
                        {
                            <option value="@route"></option>
                        }
                    </datalist>
                </div>
            </div>
            @if (!string.IsNullOrWhiteSpace(routeHintMessage))
            {
                <div class="col-12">
                    <div class="alert alert-warning py-2 mb-0">@routeHintMessage</div>
                </div>
            }
        </div>
    </div>

    <div class="mb-4">
        <SectionHeader Title="席位与票价" />
        <div class="row g-3">
            <div class="col-md-4">
                <div class="form-floating mb-3">
                    <InputSelect @bind-Value="model!.SeatType" id="seatType" class="form-select">
                        <option value="">请选择...</option>
                        <option value="硬座">硬座</option>
                        <option value="软座">软座</option>
                        <option value="硬卧">硬卧</option>
                        <option value="软卧">软卧</option>
                        <option value="包厢硬卧">包厢硬卧</option>
                        <option value="高级软卧">高级软卧</option>
                        <option value="一等软座">一等软座</option>
                        <option value="二等软座">二等软座</option>
                        <option value="商务座">商务座</option>
                        <option value="高级动卧">高级动卧</option>
                        <option value="混编硬座">混编硬座</option>
                        <option value="混编硬卧">混编硬卧</option>
                        <option value="优选一等座">优选一等座</option>
                        <option value="特等软座">特等软座</option>
                        <option value="动卧">动卧</option>
                        <option value="高级软卧">高级软卧</option>
                        <option value="一人软包">一人软包</option>
                        <option value="一等卧">一等卧</option>
                        <option value="二等卧">二等卧</option>
                        <option value="混编软座">混编软座</option>
                        <option value="混编软卧">混编软卧</option>
                        <option value="一等座">一等座</option>
                        <option value="二等座">二等座</option>
                        <option value="特等座">特等座</option>
                        <option value="多功能座">多功能座</option>
                        <option value="二等包座">二等包座</option>
                        <option value="无座">无座</option>
                    </InputSelect>
                    <label for="seatType">席别</label>
                    <ValidationMessage For="@(() => model.SeatType)" class="text-danger small" />
                </div>
            </div>
            <div class="col-md-4">
                <div class="form-floating mb-3">
                    <InputText @bind-Value="model.SeatNumber" id="seatNumber" class="form-control"
                               placeholder="如：5车1A" />
                    <label for="seatNumber">座位号</label>
                    <ValidationMessage For="@(() => model.SeatNumber)" class="text-danger small" />
                </div>
            </div>
            <div class="col-md-4">
                <div class="form-floating mb-3">
                    <InputNumber @bind-Value="model.Price" id="price" class="form-control" step="0.5"
                                 placeholder="0.00" />
                    <label for="price">票价 (¥)</label>
                    <ValidationMessage For="@(() => model.Price)" class="text-danger small" />
                </div>
            </div>
        </div>
    </div>

    <SectionHeader Title="杂项" />
    <div class="mb-4">
        <div class="form-floating">
            <InputTextArea @bind-Value="model.Notes" id="notes" class="form-control" rows="3"
                           placeholder="记录下旅途中的机破瞬间吧..." />
            <label for="notes">备注</label>
            <ValidationMessage For="@(() => model.Notes)" class="text-danger small" />
        </div>
    </div>

    <hr />

    <div class="d-flex justify-content-end align-items-center">
        <div>
            <button type="reset" class="btn btn-outline-secondary px-4 me-2">重置</button>
            <button type="submit" class="btn btn-primary px-5 shadow-sm">
                <i class="bi bi-check2-circle me-1"></i> @(IsEditMode ? "保存修改" : "保存行程记录")
            </button>
        </div>
    </div>
</EditForm>

@code {
    private const string TrainPreselectApi = "api/train/preselect?keyword=";
    private const string TrainQueryApi = "api/train/query?train=";
    private const string TrainRollingStockApi = "api/train/rolling-stock?train=";
    private const string RoutePathApi = "api/routes/path";
    private const string RouteSuggestApi = "api/routes/suggest";
    private const string RouteStationsApi = "api/routes/stations?routeName=";
    private const string TrainTicketOcrApi = "api/ocr/train-ticket";
    private const long OcrMaxUploadBytes = 5 * 1024 * 1024;
    private static readonly HashSet<string> SupportedOcrExtensions = [".jpg", ".jpeg", ".png", ".bmp"];
    private static readonly HashSet<string> SupportedOcrContentTypes =
    [
        "image/jpeg",
        "image/jpg",
        "image/png",
        "image/bmp"
    ];

    [Parameter]
    public int? TripId { get; set; }

    [SupplyParameterFromForm]
    private TripRecordDto? model { get; set; }
    private bool IsEditMode => TripId.HasValue && TripId.Value > 0;

    private List<string> trainSuggestions = [];
    private List<string> stationSuggestions = [];
    private List<string> segmentRouteNameSuggestions = [];
    private List<string> segmentStationNameSuggestions = [];
    private readonly Dictionary<string, List<RouteStationOption>> routeStationsCache =
new(StringComparer.OrdinalIgnoreCase);
    private List<TrainStopInfo> stationStops = [];
    private HashSet<string> trainSuggestionSet = new(StringComparer.OrdinalIgnoreCase);
    private CancellationTokenSource? trainSuggestCts;
    private CancellationTokenSource? rollingStockCts;
    private CancellationTokenSource? routePathCts;
    private CancellationTokenSource? segmentRouteSuggestCts;
    private CancellationTokenSource? segmentStationSuggestCts;
    private string? loadedStationsForTrain;
    private string? routeHintMessage;
    private IBrowserFile? ocrImageFile;
    private string? ocrStatusMessage;
    private bool ocrStatusIsError;
    private bool isOcrProcessing;

    protected override async Task OnInitializedAsync()
    {
        model ??= new();
        await LoadSegmentSuggestionsAsync("route", string.Empty);
        await LoadSegmentSuggestionsAsync("station", string.Empty);

        if (IsEditMode)
        {
            await LoadTripForEditAsync();
        }
    }

    private async Task LoadTripForEditAsync()
    {
        if (!IsEditMode || TripId is null)
        {
            return;
        }

        try
        {
            var existing = await HttpClient.GetFromJsonAsync<TripRecordDto>($"api/trips/{TripId.Value}");
            if (existing is null)
            {
                Nav.NavigateTo("/my-trips");
                return;
            }

            model = existing;
            if (!string.IsNullOrWhiteSpace(model.TrainNumber))
            {
                var train = model.TrainNumber.Trim().ToUpperInvariant();
                model.TrainNumber = train;
                await LoadTrainSuggestionsAsync(train, useDebounce: false);
                if (trainSuggestionSet.Contains(train))
                {
                    await LoadStationsByTrainAsync(train);
                }
            }

            await EnsureRouteStationsLoadedForCurrentSegmentsAsync();
        }
        catch (HttpRequestException ex) when (ex.StatusCode == HttpStatusCode.NotFound)
        {
            Nav.NavigateTo("/my-trips");
        }
        catch (Exception ex)
        {
            routeHintMessage = "加载记录失败，请稍后重试。";
            Console.Error.WriteLine($"Failed to load trip for edit {TripId}: {ex}");
        }
    }

    private async Task OnTrainInputChanged(ChangeEventArgs args)
    {
        if (model is null)
        {
            return;
        }

        var trainInput = args.Value?.ToString()?.Trim().ToUpperInvariant() ?? string.Empty;
        model.TrainNumber = trainInput;
        loadedStationsForTrain = null;
        stationSuggestions = [];
        stationStops = [];
        model.RollingStock = string.Empty;
        model.ViaRouteSegments = [];
        routeHintMessage = null;

        await LoadTrainSuggestionsAsync(trainInput, useDebounce: true);
    }

    private async Task OnTrainInputCompleted(FocusEventArgs _)
    {
        if (model is null)
        {
            return;
        }

        var train = model.TrainNumber.Trim().ToUpperInvariant();
        model.TrainNumber = train;

        if (string.IsNullOrWhiteSpace(train))
        {
            stationSuggestions = [];
            stationStops = [];
            loadedStationsForTrain = null;
            return;
        }

        await LoadTrainSuggestionsAsync(train, useDebounce: false);

        if (trainSuggestionSet.Contains(train))
        {
            await LoadStationsByTrainAsync(train);
            await TryLoadRollingStockAsync();
        }
        else
        {
            stationSuggestions = [];
            stationStops = [];
            loadedStationsForTrain = null;
            model.RollingStock = string.Empty;
        }
    }

    private Task OnTravelDateChanged()
    {
        return TryLoadRollingStockAsync();
    }

    private Task OnFromStationChanged(ChangeEventArgs args)
    {
        if (model is null)
        {
            return Task.CompletedTask;
        }

        model.FromStation = args.Value?.ToString()?.Trim() ?? string.Empty;
        model.ViaRouteSegments = [];
        routeHintMessage = null;
        _ = TryAutoFillTripDetails();
        return Task.CompletedTask;
    }

    private Task OnToStationChanged(ChangeEventArgs args)
    {
        if (model is null)
        {
            return Task.CompletedTask;
        }

        model.ToStation = args.Value?.ToString()?.Trim() ?? string.Empty;
        model.ViaRouteSegments = [];
        routeHintMessage = null;
        _ = TryAutoFillTripDetails();
        return Task.CompletedTask;
    }

    private async Task OnStationInputCompleted(FocusEventArgs _)
    {
        TryAutoFillTripDetails();
        await InferViaRouteSegmentsFromTimetableAsync();
    }

    private async Task OnSegmentRouteChangedAsync(int index, string? routeName)
    {
        if (model is null || index < 0 || index >= model.ViaRouteSegments.Count)
        {
            return;
        }

        var segment = model.ViaRouteSegments[index];
        segment.RouteName = routeName?.Trim() ?? string.Empty;
        segment.MileageKm = 0;
        await LoadSegmentSuggestionsAsync("route", segment.RouteName);
        await EnsureRouteStationsLoadedAsync(segment.RouteName);
        await TryRecalculateSegmentMileageAsync(index);
    }

    private async Task OnSegmentStationChangedAsync(int index, bool isFrom, string? stationName)
    {
        if (model is null || index < 0 || index >= model.ViaRouteSegments.Count)
        {
            return;
        }

        var segment = model.ViaRouteSegments[index];
        if (isFrom)
        {
            segment.FromStation = stationName?.Trim() ?? string.Empty;
        }
        else
        {
            segment.ToStation = stationName?.Trim() ?? string.Empty;
        }

        await LoadSegmentSuggestionsAsync("station", stationName?.Trim() ?? string.Empty);
        await TryRecalculateSegmentMileageAsync(index);
    }

    private async Task LoadSegmentSuggestionsAsync(string type, string keyword)
    {
        var cts = type == "route" ? segmentRouteSuggestCts : segmentStationSuggestCts;
        cts?.Cancel();
        cts = new CancellationTokenSource();
        if (type == "route")
        {
            segmentRouteSuggestCts = cts;
        }
        else
        {
            segmentStationSuggestCts = cts;
        }

        var cancellationToken = cts.Token;

        try
        {
            await Task.Delay(150, cancellationToken);
            var url = $"{RouteSuggestApi}?type={Uri.EscapeDataString(type)}&keyword={Uri.EscapeDataString(keyword)}";
            var suggestions = await HttpClient.GetFromJsonAsync<List<string>>(url, cancellationToken) ?? [];
            if (type == "route")
            {
                segmentRouteNameSuggestions = suggestions;
            }
            else
            {
                segmentStationNameSuggestions = suggestions;
            }
        }
        catch (OperationCanceledException)
        {
            // Ignore canceled requests caused by continuous typing.
        }
        catch
        {
            if (type == "route")
            {
                segmentRouteNameSuggestions = [];
            }
            else
            {
                segmentStationNameSuggestions = [];
            }
        }
    }

    private static string GetSegmentStationDatalistId(int index)
    {
        return $"segment-station-options-{index}";
    }

    private IReadOnlyList<string> GetSegmentStationSuggestions(ViaRouteSegmentDto segment)
    {
        var routeKey = segment.RouteName?.Trim() ?? string.Empty;
        if (string.IsNullOrWhiteSpace(routeKey))
        {
            return segmentStationNameSuggestions;
        }

        if (!routeStationsCache.TryGetValue(routeKey, out var stations) || stations.Count == 0)
        {
            return segmentStationNameSuggestions;
        }

        return stations.Select(x => x.StationName).ToList();
    }

    private async Task EnsureRouteStationsLoadedAsync(string routeName)
    {
        var key = routeName?.Trim() ?? string.Empty;
        if (string.IsNullOrWhiteSpace(key) || routeStationsCache.ContainsKey(key))
        {
            return;
        }

        try
        {
            var url = $"{RouteStationsApi}{Uri.EscapeDataString(key)}";
            var stations = await HttpClient.GetFromJsonAsync<List<RouteStationOption>>(url) ?? [];
            routeStationsCache[key] = stations;
        }
        catch
        {
            routeStationsCache[key] = [];
        }
    }

    private async Task EnsureRouteStationsLoadedForCurrentSegmentsAsync()
    {
        if (model is null)
        {
            return;
        }

        var routeNames = model.ViaRouteSegments
            .Select(x => x.RouteName?.Trim() ?? string.Empty)
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();

        foreach (var routeName in routeNames)
        {
            await EnsureRouteStationsLoadedAsync(routeName);
        }
    }

    private void FillMileageFromViaSegments()
    {
        ApplyMileageFromViaSegments(overwriteWithZero: true);
    }

    private void ApplyMileageFromViaSegments(bool overwriteWithZero = false)
    {
        if (model is null || model.ViaRouteSegments.Count == 0)
        {
            return;
        }

        var total = model.ViaRouteSegments.Sum(x => x.MileageKm > 0 ? x.MileageKm : 0m);
        if (overwriteWithZero || total > 0)
        {
            model.MileageKm = total;
        }
    }

    private async Task TryRecalculateSegmentMileageAsync(int index)
    {
        if (model is null || index < 0 || index >= model.ViaRouteSegments.Count)
        {
            return;
        }

        var segment = model.ViaRouteSegments[index];
        segment.MileageKm = 0;
        if (string.IsNullOrWhiteSpace(segment.RouteName) ||
            string.IsNullOrWhiteSpace(segment.FromStation) ||
            string.IsNullOrWhiteSpace(segment.ToStation))
        {
            ApplyMileageFromViaSegments();
            return;
        }

        var routeKey = segment.RouteName.Trim();
        await EnsureRouteStationsLoadedAsync(routeKey);
        if (!routeStationsCache.TryGetValue(routeKey, out var stations))
        {
            ApplyMileageFromViaSegments();
            return;
        }

        var from = stations.FirstOrDefault(x => string.Equals(x.StationName, segment.FromStation,
StringComparison.OrdinalIgnoreCase));
        var to = stations.FirstOrDefault(x => string.Equals(x.StationName, segment.ToStation,
StringComparison.OrdinalIgnoreCase));
        if (from is null || to is null)
        {
            ApplyMileageFromViaSegments();
            return;
        }

        segment.MileageKm = Math.Abs(to.Mileage - from.Mileage);
        ApplyMileageFromViaSegments();
    }

    private async Task LoadTrainSuggestionsAsync(string keyword, bool useDebounce)
    {
        trainSuggestCts?.Cancel();
        trainSuggestCts = new CancellationTokenSource();
        var cancellationToken = trainSuggestCts.Token;

        try
        {
            if (string.IsNullOrWhiteSpace(keyword))
            {
                trainSuggestions = [];
                trainSuggestionSet.Clear();
                return;
            }

            if (useDebounce)
            {
                await Task.Delay(220, cancellationToken);
            }

            var raw = await HttpClient.GetFromJsonAsync<List<string>>(
                $"{TrainPreselectApi}{Uri.EscapeDataString(keyword)}",
                cancellationToken);

            var expanded = ExpandTrainNumbers(raw);
            trainSuggestions = expanded;
            trainSuggestionSet = expanded.ToHashSet(StringComparer.OrdinalIgnoreCase);
        }
        catch (OperationCanceledException)
        {
            // Ignore canceled request caused by continuous typing.
        }
        catch
        {
            trainSuggestions = [];
            trainSuggestionSet.Clear();
        }
    }

    private async Task TryLoadRollingStockAsync()
    {
        if (model is null)
        {
            return;
        }

        var train = model.TrainNumber.Trim().ToUpperInvariant();
        if (string.IsNullOrWhiteSpace(train))
        {
            model.RollingStock = string.Empty;
            return;
        }

        rollingStockCts?.Cancel();
        rollingStockCts = new CancellationTokenSource();
        var cancellationToken = rollingStockCts.Token;

        try
        {
            var url = $"{TrainRollingStockApi}{Uri.EscapeDataString(train)}&date={model.TravelDate:yyyy-MM-dd}";
            var result = await HttpClient.GetFromJsonAsync<TrainRollingStockResponse>(url, cancellationToken);
            model.RollingStock = result?.RollingStock?.Trim() ?? string.Empty;
        }
        catch (OperationCanceledException)
        {
            // Ignore canceled request caused by rapid changes.
        }
        catch
        {
            model.RollingStock = string.Empty;
        }
    }

    private async Task LoadStationsByTrainAsync(string train)
    {
        if (loadedStationsForTrain == train)
        {
            return;
        }

        try
        {
            var json = await HttpClient.GetStringAsync($"{TrainQueryApi}{Uri.EscapeDataString(train)}");
            using var doc = JsonDocument.Parse(json);

            stationStops = ExtractStationStops(doc.RootElement);
            stationSuggestions = stationStops
                .Select(x => x.Station)
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .ToList();
            loadedStationsForTrain = train;
            _ = TryAutoFillTripDetails();
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Failed to load stations for train {train}: {ex}");
            stationSuggestions = [];
            stationStops = [];
            loadedStationsForTrain = null;
        }
    }

    private void OnOcrFileSelected(InputFileChangeEventArgs args)
    {
        ocrStatusMessage = null;
        ocrStatusIsError = false;

        ocrImageFile = args.FileCount > 0 ? args.File : null;
        if (ocrImageFile is null)
        {
            return;
        }

        if (!IsSupportedOcrFile(ocrImageFile))
        {
            ocrImageFile = null;
            SetOcrStatus("仅支持 JPG/JPEG/PNG/BMP 图片。", isError: true);
            return;
        }

        if (ocrImageFile.Size > OcrMaxUploadBytes)
        {
            ocrImageFile = null;
            SetOcrStatus($"图片过大，请上传不超过 {OcrMaxUploadBytes / 1024 / 1024}MB 的图片。", isError: true);
        }
    }

    private async Task RecognizeTicketAsync()
    {
        if (model is null)
        {
            return;
        }

        if (ocrImageFile is null)
        {
            SetOcrStatus("请先选择车票图片。", isError: true);
            return;
        }

        if (isOcrProcessing)
        {
            return;
        }

        isOcrProcessing = true;
        SetOcrStatus("正在识别车票，请稍候...", isError: false);

        try
        {
            using var fileStream = ocrImageFile.OpenReadStream(OcrMaxUploadBytes);
            using var content = new MultipartFormDataContent();
            using var streamContent = new StreamContent(fileStream);

            if (!string.IsNullOrWhiteSpace(ocrImageFile.ContentType))
            {
                streamContent.Headers.ContentType = MediaTypeHeaderValue.Parse(ocrImageFile.ContentType);
            }

            content.Add(streamContent, "imageFile", ocrImageFile.Name);
            using var response = await HttpClient.PostAsync(TrainTicketOcrApi, content);
            if (!response.IsSuccessStatusCode)
            {
                var errorMessage = await ReadApiErrorMessageAsync(response);
                SetOcrStatus($"识别失败：{errorMessage}", isError: true);
                return;
            }

            var ocrResult = await response.Content.ReadFromJsonAsync<TrainTicketOcrResponse>();
            if (ocrResult is null)
            {
                SetOcrStatus("识别失败：返回结果为空。", isError: true);
                return;
            }

            await ApplyOcrResultAsync(ocrResult);
            SetOcrStatus("识别成功，已填充可识别字段。", isError: false);
        }
        catch (IOException)
        {
            SetOcrStatus("读取图片失败，请确认文件大小和格式后重试。", isError: true);
        }
        catch (HttpRequestException)
        {
            SetOcrStatus("网络异常，无法完成识别。", isError: true);
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Failed to recognize ticket: {ex}");
            SetOcrStatus("识别失败，请稍后重试。", isError: true);
        }
        finally
        {
            isOcrProcessing = false;
        }
    }

    private async Task ApplyOcrResultAsync(TrainTicketOcrResponse result)
    {
        if (model is null)
        {
            return;
        }

        if (!string.IsNullOrWhiteSpace(result.TrainNumber))
        {
            model.TrainNumber = result.TrainNumber.Trim().ToUpperInvariant();
        }

        if (result.TravelDate.HasValue)
        {
            model.TravelDate = result.TravelDate.Value;
        }

        if (!string.IsNullOrWhiteSpace(result.FromStation))
        {
            model.FromStation = result.FromStation.Trim();
        }

        if (!string.IsNullOrWhiteSpace(result.ToStation))
        {
            model.ToStation = result.ToStation.Trim();
        }

        if (result.DepartureTime.HasValue)
        {
            model.DepartureTime = result.DepartureTime.Value;
        }

        if (!string.IsNullOrWhiteSpace(result.SeatType))
        {
            model.SeatType = result.SeatType.Trim();
        }

        if (!string.IsNullOrWhiteSpace(result.SeatNumber))
        {
            model.SeatNumber = result.SeatNumber.Trim();
        }

        if (result.Price is > 0)
        {
            model.Price = result.Price.Value;
        }

        model.ViaRouteSegments = [];
        routeHintMessage = null;
        loadedStationsForTrain = null;
        stationSuggestions = [];
        stationStops = [];

        var train = model.TrainNumber.Trim().ToUpperInvariant();
        if (!string.IsNullOrWhiteSpace(train))
        {
            model.TrainNumber = train;
            await LoadTrainSuggestionsAsync(train, useDebounce: false);
            if (trainSuggestionSet.Contains(train))
            {
                await LoadStationsByTrainAsync(train);
                await TryLoadRollingStockAsync();
            }
        }

        if (stationStops.Count > 0 &&
            !string.IsNullOrWhiteSpace(model.FromStation) &&
            !string.IsNullOrWhiteSpace(model.ToStation))
        {
            if (model.MileageKm <= 0)
            {
                _ = TryAutoFillTripDetails();
            }

            await InferViaRouteSegmentsFromTimetableAsync();
        }
    }

    private static bool IsSupportedOcrFile(IBrowserFile file)
    {
        var extension = Path.GetExtension(file.Name);
        var extensionAllowed = !string.IsNullOrWhiteSpace(extension) &&
            SupportedOcrExtensions.Contains(extension);

        var contentType = file.ContentType?.Trim() ?? string.Empty;
        var contentTypeAllowed = !string.IsNullOrWhiteSpace(contentType) &&
            SupportedOcrContentTypes.Contains(contentType);

        return extensionAllowed || contentTypeAllowed;
    }

    private static async Task<string> ReadApiErrorMessageAsync(HttpResponseMessage response)
    {
        try
        {
            var payload = await response.Content.ReadFromJsonAsync<ApiErrorResponse>();
            if (!string.IsNullOrWhiteSpace(payload?.Message))
            {
                return payload.Message;
            }
        }
        catch
        {
            // ignore parse failures
        }

        return $"HTTP {(int)response.StatusCode}";
    }

    private void SetOcrStatus(string message, bool isError)
    {
        ocrStatusMessage = message;
        ocrStatusIsError = isError;
    }

    private static List<string> ExpandTrainNumbers(List<string>? source)
    {
        if (source is null || source.Count == 0)
        {
            return [];
        }

        return source
            .SelectMany(item => item.Split('/', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
            .Where(item => !string.IsNullOrWhiteSpace(item))
            .Select(item => item.ToUpperInvariant())
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .Take(200)
            .ToList();
    }

    private bool TryAutoFillTripDetails()
    {
        if (model is null || stationStops.Count == 0)
        {
            return false;
        }

        var from = model.FromStation.Trim();
        var to = model.ToStation.Trim();
        if (string.IsNullOrWhiteSpace(from) || string.IsNullOrWhiteSpace(to))
        {
            return false;
        }

        var fromStop = stationStops.FirstOrDefault(x => string.Equals(x.Station, from, StringComparison.OrdinalIgnoreCase));
        var toStop = stationStops.FirstOrDefault(x => string.Equals(x.Station, to, StringComparison.OrdinalIgnoreCase));

        if (fromStop is null || toStop is null)
        {
            return false;
        }

        if (fromStop.Order >= toStop.Order)
        {
            return false;
        }

        if (TryParseTime(fromStop.Depart, out var departure))
        {
            model.DepartureTime = departure;
        }

        if (TryParseTime(toStop.Arrive, out var arrival))
        {
            model.ArrivalTime = arrival;
        }

        var mileage = toStop.Distance - fromStop.Distance;
        if (mileage > 0)
        {
            model.MileageKm = mileage;
            return true;
        }

        return false;
    }

    private static bool TryParseTime(string? value, out TimeOnly result)
    {
        return TimeOnly.TryParse(value, out result);
    }

    private async Task InferViaRouteSegmentsFromTimetableAsync()
    {
        if (model is null || stationStops.Count == 0)
        {
            return;
        }

        var from = model.FromStation.Trim();
        var to = model.ToStation.Trim();
        if (string.IsNullOrWhiteSpace(from) || string.IsNullOrWhiteSpace(to))
        {
            return;
        }

        var fromStop = stationStops.FirstOrDefault(x => string.Equals(x.Station, from, StringComparison.OrdinalIgnoreCase));
        var toStop = stationStops.FirstOrDefault(x => string.Equals(x.Station, to, StringComparison.OrdinalIgnoreCase));
        if (fromStop is null || toStop is null || fromStop.Order >= toStop.Order)
        {
            routeHintMessage = "区间站点无效，无法自动推断经由。";
            return;
        }

        var intervalStops = stationStops
            .Where(x => x.Order >= fromStop.Order && x.Order <= toStop.Order)
            .OrderBy(x => x.Order)
            .ToList();

        if (intervalStops.Count < 2)
        {
            routeHintMessage = "区间停站不足，无法自动推断经由。";
            return;
        }

        routePathCts?.Cancel();
        routePathCts = new CancellationTokenSource();
        var cancellationToken = routePathCts.Token;

        try
        {
            var allSegments = new List<ViaRouteSegmentDto>();
            var notices = new List<string>();

            for (var i = 0; i < intervalStops.Count - 1;)
            {
                var current = intervalStops[i];
                var next = intervalStops[i + 1];

                // Missing mileage at the middle station: infer via by previous->next shortest path.
                if ((!current.HasDistance || !next.HasDistance) &&
                    i > 0 &&
                    i + 1 < intervalStops.Count - 1 &&
                    !intervalStops[i + 1].HasDistance)
                {
                    var prev = intervalStops[i];
                    var mid = intervalStops[i + 1];
                    var after = intervalStops[i + 2];
                    var fallbackUri = BuildRoutePathRequestUri(prev.Station, after.Station, targetMileage: null, allowShortestFallback:
true);
                    var fallbackResult = await HttpClient.GetFromJsonAsync<RoutePathResponse>(fallbackUri, cancellationToken);
                    if (fallbackResult is null || !fallbackResult.Found || fallbackResult.RouteSegments is null ||
fallbackResult.RouteSegments.Count == 0)
                    {
                        routeHintMessage = $"站点 {mid.Station} 缺里程，且无法根据前后站推断最短经由。";
                        return;
                    }

                    allSegments.AddRange(fallbackResult.RouteSegments.Select(segment => new ViaRouteSegmentDto
                    {
                        RouteName = segment.RouteName,
                        FromStation = segment.FromStation,
                        ToStation = segment.ToStation,
                        MileageKm = segment.MileageKm
                    }));
                    notices.Add($"站点 {mid.Station} 无里程，已按 {prev.Station}->{after.Station} 最短经由推断。");
                    i += 2;
                    continue;
                }

                var sectionMileage = next.Distance - current.Distance;
                if (!TryGetApproxIntegerMileage(sectionMileage, out var targetMileage))
                {
                    var fallbackUri = BuildRoutePathRequestUri(current.Station, next.Station, targetMileage: null, allowShortestFallback:
true);
                    var fallbackResult = await HttpClient.GetFromJsonAsync<RoutePathResponse>(fallbackUri, cancellationToken);
                    if (fallbackResult is null || !fallbackResult.Found || fallbackResult.RouteSegments is null ||
fallbackResult.RouteSegments.Count == 0)
                    {
                        routeHintMessage = $"区间 {current.Station} -> {next.Station} 无法自动推断经由。可改手动或点击“计算最短经由”。";
                        return;
                    }

                    allSegments.AddRange(fallbackResult.RouteSegments.Select(segment => new ViaRouteSegmentDto
                    {
                        RouteName = segment.RouteName,
                        FromStation = segment.FromStation,
                        ToStation = segment.ToStation,
                        MileageKm = segment.MileageKm
                    }));
                    notices.Add($"区间 {current.Station}->{next.Station} 里程缺失，已按最短经由推断。");
                    i++;
                    continue;
                }

                var requestUri = BuildRoutePathRequestUri(current.Station, next.Station, targetMileage, allowShortestFallback: false);
                var result = await HttpClient.GetFromJsonAsync<RoutePathResponse>(requestUri, cancellationToken);
                if (result is null || !result.Found || result.RouteSegments is null || result.RouteSegments.Count == 0)
                {
                    var fallbackUri = BuildRoutePathRequestUri(current.Station, next.Station, targetMileage: null, allowShortestFallback:
true);
                    var fallbackResult = await HttpClient.GetFromJsonAsync<RoutePathResponse>(fallbackUri, cancellationToken);
                    if (fallbackResult is null || !fallbackResult.Found || fallbackResult.RouteSegments is null ||
fallbackResult.RouteSegments.Count == 0)
                    {
                        routeHintMessage = $"区间 {current.Station} -> {next.Station} 未匹配到经由，且最短路径也不可用。";
                        return;
                    }

                    allSegments.AddRange(fallbackResult.RouteSegments.Select(segment => new ViaRouteSegmentDto
                    {
                        RouteName = segment.RouteName,
                        FromStation = segment.FromStation,
                        ToStation = segment.ToStation,
                        MileageKm = segment.MileageKm
                    }));
                    notices.Add($"区间 {current.Station}->{next.Station} 未匹配到目标经由，已改用最短路径。");
                    i++;
                    continue;
                }

                foreach (var segment in result.RouteSegments)
                {
                    allSegments.Add(new ViaRouteSegmentDto
                    {
                        RouteName = segment.RouteName,
                        FromStation = segment.FromStation,
                        ToStation = segment.ToStation,
                        MileageKm = segment.MileageKm
                    });
                }

                i++;
            }

            model.ViaRouteSegments = MergeConnectedSegments(allSegments);
            await EnsureRouteStationsLoadedForCurrentSegmentsAsync();
            ApplyMileageFromViaSegments();
            routeHintMessage = notices.Count > 0
                ? string.Join(" ", notices)
                : null;
        }
        catch (OperationCanceledException)
        {
            // Ignore canceled request caused by rapid input changes.
        }
        catch (Exception ex)
        {
            routeHintMessage = "自动推断经由失败，可手动编辑或点击“计算最短经由”。";
            Console.Error.WriteLine($"Failed to infer via routes by timetable sections for {from} -> {to}: {ex}");
        }
    }

    private async Task ComputeShortestViaRoutesAsync()
    {
        if (model is null)
        {
            return;
        }

        var from = model.FromStation.Trim();
        var to = model.ToStation.Trim();
        if (string.IsNullOrWhiteSpace(from) || string.IsNullOrWhiteSpace(to))
        {
            routeHintMessage = "请先填写出发地和目的地。";
            return;
        }

        routePathCts?.Cancel();
        routePathCts = new CancellationTokenSource();
        var cancellationToken = routePathCts.Token;

        try
        {
            var requestUri = BuildRoutePathRequestUri(from, to, targetMileage: null, allowShortestFallback: true);
            var result = await HttpClient.GetFromJsonAsync<RoutePathResponse>(requestUri, cancellationToken);
            if (result is null || !result.Found || result.RouteSegments is null || result.RouteSegments.Count == 0)
            {
                routeHintMessage = "未找到可用经由线路。";
                model.ViaRouteSegments = [];
                return;
            }

            model.ViaRouteSegments = MergeConnectedSegments(result.RouteSegments.Select(x => new ViaRouteSegmentDto
            {
                RouteName = x.RouteName,
                FromStation = x.FromStation,
                ToStation = x.ToStation,
                MileageKm = x.MileageKm
            }));
            await EnsureRouteStationsLoadedForCurrentSegmentsAsync();
            ApplyMileageFromViaSegments();
            routeHintMessage = null;
        }
        catch (OperationCanceledException)
        {
            // Ignore canceled request caused by rapid input changes.
        }
        catch (Exception ex)
        {
            routeHintMessage = "计算最短经由失败，请稍后重试。";
            Console.Error.WriteLine($"Failed to calculate shortest route path for {from} -> {to}: {ex}");
        }
    }

    private void AddViaSegment()
    {
        model?.ViaRouteSegments.Add(new ViaRouteSegmentDto());
        ApplyMileageFromViaSegments();
    }

    private void RemoveViaSegment(int index)
    {
        if (model is null || index < 0 || index >= model.ViaRouteSegments.Count)
        {
            return;
        }

        model.ViaRouteSegments.RemoveAt(index);
        ApplyMileageFromViaSegments();
    }

    private static string BuildRoutePathRequestUri(string from, string to, int? targetMileage, bool allowShortestFallback)
    {
        var query =
$"from={Uri.EscapeDataString(from)}&to={Uri.EscapeDataString(to)}&allowShortestFallback={allowShortestFallback.ToString().ToLowerInvariant()}";
        if (targetMileage.HasValue)
        {
            query += $"&targetMileage={targetMileage.Value}";
        }

        return $"{RoutePathApi}?{query}";
    }

    private static bool TryGetApproxIntegerMileage(decimal mileageKm, out int value)
    {
        value = 0;
        if (mileageKm <= 0)
        {
            return false;
        }

        if (mileageKm > int.MaxValue)
        {
            return false;
        }

        var rounded = Math.Round(mileageKm);
        if (Math.Abs(mileageKm - rounded) > 0.2m)
        {
            return false;
        }

        value = (int)rounded;
        return value > 0;
    }

    private static List<ViaRouteSegmentDto> MergeConnectedSegments(IEnumerable<ViaRouteSegmentDto> segments)
    {
        var result = new List<ViaRouteSegmentDto>();
        foreach (var raw in segments)
        {
            var current = new ViaRouteSegmentDto
            {
                RouteName = raw.RouteName?.Trim() ?? string.Empty,
                FromStation = raw.FromStation?.Trim() ?? string.Empty,
                ToStation = raw.ToStation?.Trim() ?? string.Empty,
                MileageKm = raw.MileageKm
            };

            if (string.IsNullOrWhiteSpace(current.RouteName) ||
                string.IsNullOrWhiteSpace(current.FromStation) ||
                string.IsNullOrWhiteSpace(current.ToStation))
            {
                continue;
            }

            if (result.Count == 0)
            {
                result.Add(current);
                continue;
            }

            var last = result[^1];
            if (string.Equals(last.RouteName, current.RouteName, StringComparison.OrdinalIgnoreCase) &&
                string.Equals(last.ToStation, current.FromStation, StringComparison.OrdinalIgnoreCase))
            {
                last.ToStation = current.ToStation;
                last.MileageKm += current.MileageKm;
                continue;
            }

            result.Add(current);
        }

        return result;
    }

    private bool ValidateViaRouteSegments()
    {
        if (model is null || model.ViaRouteSegments.Count == 0)
        {
            return true;
        }

        var first = model.ViaRouteSegments[0];
        var last = model.ViaRouteSegments[^1];
        if (!string.Equals(first.FromStation?.Trim(), model.FromStation?.Trim(), StringComparison.OrdinalIgnoreCase))
        {
            routeHintMessage = "第一段起点必须与出发地一致。";
            return false;
        }

        if (!string.Equals(last.ToStation?.Trim(), model.ToStation?.Trim(), StringComparison.OrdinalIgnoreCase))
        {
            routeHintMessage = "最后一段终点必须与目的地一致。";
            return false;
        }

        for (var i = 0; i < model.ViaRouteSegments.Count - 1; i++)
        {
            var current = model.ViaRouteSegments[i];
            var next = model.ViaRouteSegments[i + 1];
            if (!string.Equals(current.ToStation?.Trim(), next.FromStation?.Trim(), StringComparison.OrdinalIgnoreCase))
            {
                routeHintMessage = $"第 {i + 1} 段终点与第 {i + 2} 段起点不衔接。";
                return false;
            }
        }

        routeHintMessage = null;
        return true;
    }

    private static List<TrainStopInfo> ExtractStationStops(JsonElement root)
    {
        if (!root.TryGetProperty("timetable", out var timetable) || timetable.ValueKind != JsonValueKind.Array)
        {
            return [];
        }

        var stations = new List<TrainStopInfo>();
        var index = 0;

        foreach (var stop in timetable.EnumerateArray())
        {
            if (stop.ValueKind != JsonValueKind.Object)
            {
                continue;
            }

            if (!stop.TryGetProperty("station", out var stationElement))
            {
                continue;
            }

            var station = stationElement.GetString();
            if (!string.IsNullOrWhiteSpace(station))
            {
                var arrive = stop.TryGetProperty("arrive", out var arriveElement)
                    ? arriveElement.GetString()
                    : null;
                var depart = stop.TryGetProperty("depart", out var departElement)
                    ? departElement.GetString()
                    : null;
                var distance = 0m;
                var hasDistance = false;
                if (stop.TryGetProperty("distance", out var distanceElement))
                {
                    if (distanceElement.ValueKind == JsonValueKind.Number && distanceElement.TryGetDecimal(out var km))
                    {
                        distance = km;
                        hasDistance = true;
                    }
                    else if (distanceElement.ValueKind == JsonValueKind.String)
                    {
                        var text = distanceElement.GetString()?.Trim();
                        if (string.Equals(text, "-", StringComparison.Ordinal))
                        {
                            distance = 0m;
                        }
                        else if (decimal.TryParse(text, out var parsedKm))
                        {
                            distance = parsedKm;
                            hasDistance = true;
                        }
                    }
                }

                stations.Add(new TrainStopInfo(station, arrive, depart, distance, hasDistance, index));
                index++;
            }
        }

        return stations
            .GroupBy(x => x.Station, StringComparer.OrdinalIgnoreCase)
            .Select(g => g.First())
            .ToList();
    }

    private async Task HandleSubmit()
    {
        if (model is not null)
        {
            if (!ValidateViaRouteSegments())
            {
                return;
            }

            var response = IsEditMode
                ? await HttpClient.PutAsJsonAsync($"api/trips/{TripId!.Value}", model)
                : await HttpClient.PostAsJsonAsync("api/trips", model);
            if (response.IsSuccessStatusCode)
            {
                if (IsEditMode && TripId.HasValue)
                {
                    Nav.NavigateTo($"/trip-details/{TripId.Value}");
                }
                else
                {
                    Nav.NavigateTo("/my-trips");
                }
            }
            else
            {
                routeHintMessage = IsEditMode
                    ? "保存修改失败，请检查经由分段是否连通。"
                    : "保存失败，请检查经由分段是否连通。";
            }
        }
    }
}