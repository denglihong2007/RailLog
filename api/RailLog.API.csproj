<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <UserSecretsId>RailLog.API-31f26a55-9d04-45ec-8420-597cb4e7182d</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <None Update="Assets\db\routes.db">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Assets\ads\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <PackageReference Include="MailKit" Version="4.18.1" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.13" />
    <PackageReference Include="NPinyin.Core" Version="3.0.0" />
    <PackageReference Include="SkiaSharp" Version="4.153.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.153.1" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <!-- bundle_e_sqlite3 3.0.5 仍钉在 SQLite 3.53.4，直接提到最新补丁版。 -->
    <PackageReference Include="SQLite" Version="3.54.0" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.13" />
    <!-- MimeKit 4.18.1 仍依赖有已知漏洞的 Pkcs 10.0.0，直接提到最新补丁版覆盖传递依赖。 -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

</Project>
